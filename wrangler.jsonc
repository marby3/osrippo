{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "osrippo",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			// 本番とステージングの D1 はまだ作っていない（ローカルだけで使う）
			"binding": "DB",
			"database_name": "osrippo",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],
	// ログインの秘密の値（設計書 docs/spec/23.md）。本番とステージングは wrangler secret put、手元は .dev.vars。
	// ここで名前を宣言すると、wrangler types は .dev.vars の有無で違う型を作らない。
	// BETTER_AUTH_URL は秘密ではないが、環境ごとに違い、ほかと同じく型を作りたいのでここに並べる
	"secrets": {
		"required": [
			"BETTER_AUTH_URL",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"LINE_CLIENT_ID",
			"LINE_CLIENT_SECRET",
			// 課題の投稿（設計書 docs/spec/25.md 決めたこと8・9・14）
			"TURNSTILE_SECRET_KEY",
			"IP_HASH_SECRET"
		]
	},
	"vars": {
		// Turnstile のサイトキー（公開してよい値）。いまは Cloudflare のテスト用の鍵（いつも通る）。
		// 本番とステージングの値はデプロイの Issue で決める
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
	},
	// 会期の終わりの処理（設計書 docs/spec/71.md 決めたこと3）。UTC で書くので、日本時間の 0時1分
	"triggers": {
		"crons": ["1 15 * * *"]
	},
	"workers_dev": true,
	"preview_urls": true,
	// 確かめるためのステージング（Issue #113）。pnpm build のあと wrangler deploy --env staging。公開ではない（URL は広めない）。
	// 秘密の値は wrangler secret put --env staging。ログインのクライアントはまだないので、ログインの値はダミー
	"env": {
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "osrippo-staging",
					"database_id": "ca1c0d81-d4ea-4b62-a31e-58048ac622c6",
					"migrations_dir": "drizzle"
				}
			],
			"vars": {
				// Turnstile のサイトキー（公開してよい値）。ウィジェット osrippo-staging（osrippo-staging.marbyxmax10.workers.dev だけ）
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF4cryiiv6FIHZHg",
				// 検索に載せない（Issue #156）。すべての応答に X-Robots-Tag: noindex, nofollow を付ける。本番には置かない
				"NOINDEX": "1"
			},
			"triggers": {
				"crons": ["1 15 * * *"]
			}
		}
	}
}
