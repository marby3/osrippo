{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "osrippo",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			// 本番とステージングの D1 はまだ作っていない（ローカルだけで使う）
			"binding": "DB",
			"database_name": "osrippo",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],
	// ログインの秘密の値（設計書 docs/spec/23.md）。本番とステージングは wrangler secret put、手元は .dev.vars。
	// ここで名前を宣言すると、wrangler types は .dev.vars の有無で違う型を作らない
	"secrets": {
		"required": [
			"BETTER_AUTH_URL",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"LINE_CLIENT_ID",
			"LINE_CLIENT_SECRET"
		]
	},
	"workers_dev": true,
	"preview_urls": true
}
