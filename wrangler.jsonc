{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "osrippo",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			// 本番とステージングの D1 はまだ作っていない（ローカルだけで使う）
			"binding": "DB",
			"database_name": "osrippo",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
